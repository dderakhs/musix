# ---------------------------------------------------------------- client
# Exposed to the browser by Vite. The publishable/anon key is safe to ship:
# every table it can reach is guarded by row level security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- server
# Used only by the /api serverless functions, which own the catalogue tables.
# NEVER prefix this with VITE_ — that would bundle it into the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- optional
# MusicBrainz asks for a contact address in the User-Agent of every request.
MUSICBRAINZ_APP_CONTACT=https://github.com/dderakhs/musix

# Adds Last.fm scrobble counts to the public score. Free key from
# https://www.last.fm/api/account/create — everything works without it.
LASTFM_API_KEY=
