# ---------------------------------------------------------------- client
# Exposed to the browser. The publishable/anon key is safe to ship: every table
# it can reach is guarded by row level security.
#
# The build also accepts these under the names the Vercel Supabase integration
# injects, so you do not have to create VITE_ copies by hand:
#   URL: VITE_SUPABASE_URL | SUPABASE_URL | NEXT_PUBLIC_SUPABASE_URL
#   key: VITE_SUPABASE_ANON_KEY | SUPABASE_ANON_KEY | SUPABASE_PUBLISHABLE_KEY
#        | NEXT_PUBLIC_SUPABASE_ANON_KEY
# The build log prints which ones it found.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- server
# Used only by the /api serverless functions, which own the catalogue tables.
# NEVER prefix this with VITE_ — that would bundle it into the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- optional
# MusicBrainz asks for a contact address in the User-Agent of every request.
MUSICBRAINZ_APP_CONTACT=https://github.com/dderakhs/musix

# The public score works without any of the keys below; each one it has simply
# makes the score better evidenced. All three are free.

# Spotify — by far the highest-value key here. Every track carries a 0-100
# popularity index already normalised across Spotify's whole catalogue, which is
# the one signal that needs no correction for era or platform reach. Create an
# app at https://developer.spotify.com/dashboard (free), then Settings -> Client
# ID and "View client secret". No redirect URI is needed: this uses the
# client-credentials flow and reads public catalogue data only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius lyrics pageviews — the sharpest per-track attention signal available.
# Token: https://genius.com/api-clients  (only view counts are read, never lyrics)
GENIUS_ACCESS_TOKEN=

# Reddit discussion volume. Register a "script" app for a free client id/secret:
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Last.fm scrobble counts. Free key from https://www.last.fm/api/account/create
LASTFM_API_KEY=
